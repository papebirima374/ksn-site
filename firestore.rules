rules_version = '2';

// =========================================================================
// Firestore Security Rules — Site KSN
//
// À copier-coller dans Firebase Console → Firestore Database → Rules.
// Ne pas oublier de cliquer sur "Publier" après modification.
//
// Modèle de permissions :
//   - read public : galerie photos, vidéos archives, articles, biblio
//     (tout ce qui est destiné à être affiché sur le site public)
//   - write admin : restreint aux utilisateurs avec la permission
//     correspondante dans users/<uid>.permissions[]
//
// IMPORTANT : un admin (users/<uid>.role == "admin") bypass TOUS les
// checks de permission. Ses droits ne dépendent pas de son tableau
// permissions[].
// =========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == "admin";
    }

    // Slug de la commission rattachee au compte connecte.
    // users/<uid>.commission stocke le NOM de la commission (historique du
    // projet), pas le slug : la correspondance se fait donc ici. Les anciens
    // libelles (avant la fusion Secretariat + Administratif) sont acceptes,
    // sinon les comptes deja crees perdraient l'acces a leur dossier.
    function monSlug() {
      return !isSignedIn() ? ""
        : userDoc().commission == "Éducation et Culture" ? "education-culture"
        : userDoc().commission == "Éducation & Culture" ? "education-culture"
        : userDoc().commission == "Finances" ? "finances"
        : userDoc().commission == "Social et Développement" ? "social-developpement"
        : userDoc().commission == "Sociale & Développement" ? "social-developpement"
        : userDoc().commission == "Organisation" ? "organisation"
        : userDoc().commission == "Communication" ? "communication"
        : userDoc().commission == "Secrétariat et Administratif" ? "secretariat-administratif"
        : userDoc().commission == "Secrétariat" ? "secretariat-administratif"
        : userDoc().commission == "Administratif" ? "secretariat-administratif"
        : "";
    }

    // Le Secretariat depouille les travaux de TOUTES les commissions : c'est
    // son role a l'assemblee. Les autres commissions ne voient que le leur.
    function estSecretariat() {
      return monSlug() == "secretariat-administratif";
    }

    // hasPerm renvoie true si :
    //   - l'utilisateur est admin (bypass complet), OU
    //   - la permission est dans son tableau users/<uid>.permissions[]
    function hasPerm(perm) {
      return isSignedIn() && (
        userDoc().role == "admin"
        || (userDoc().permissions != null && perm in userDoc().permissions)
      );
    }

    // ─── Users (profils Auth + permissions) ─────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Création : par soi-même (auto-inscription) OU par un gestionnaire
      // d'utilisateurs (l'admin crée le compte via une session secondaire,
      // mais le doc Firestore est écrit sous SA session → besoin de users.write).
      allow create: if isSignedIn() && (request.auth.uid == uid || hasPerm("users.write"));
      allow update: if isSignedIn() && (request.auth.uid == uid || hasPerm("users.write"));
      allow delete: if hasPerm("users.write");
    }

    // ─── Membres du Dahira ──────────────────────────────────────────────
    // Lecture : réservée aux utilisateurs CONNECTÉS (pas le public anonyme).
    // Le lien membre↔compte se fait par email/téléphone, donc on ne peut pas
    // restreindre à "sa propre fiche" sans casser "Mon Espace" (la détection
    // du statut interroge members par email/téléphone). Le public anonyme,
    // lui, passe par /publicCards qui n'expose AUCUNE donnée privée.
    match /members/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();  // visiteur peut creer sa propre fiche
      allow update: if isSignedIn() && (
        // self-update : statut en_attente → actif (apres paiement Wave)
        (resource.data.userId == request.auth.uid
          && resource.data.statut == "en_attente"
          && request.resource.data.statut == "actif")
        || hasPerm("members.write")
      );
      // Suppression réservée aux admins (la commission peut éditer, pas supprimer).
      allow delete: if isAdmin();
    }

    // ─── Cartes publiques (vérification QR) ─────────────────────────────
    // Expose UNIQUEMENT les champs nécessaires à la vérification d'une carte
    // (nom, matricule, statut, photo, région). Aucune donnée privée.
    match /publicCards/{matricule} {
      allow read: if true;
      allow write: if hasPerm("members.write");
    }

    // ─── Dons ───────────────────────────────────────────────────────────
    // N'importe qui peut enregistrer son don ; seules les finances le lisent.
    match /donations/{id} {
      allow create: if true;
      allow read, update, delete: if hasPerm("finances.write");
    }

    // ─── Galerie photos ─────────────────────────────────────────────────
    match /gallery/{id} {
      allow read: if true;  // tout le monde voit les photos
      allow write: if hasPerm("gallery.write");
    }

    // ─── Vidéos YouTube archivées ───────────────────────────────────────
    match /youtube_links/{id} {
      allow read: if true;
      allow write: if hasPerm("gallery.write");
    }

    // ─── Newsletter ─────────────────────────────────────────────────────
    match /newsletter/{id} {
      allow create: if true;          // n'importe qui peut s'inscrire
      allow read, update, delete: if hasPerm("members.write");
    }

    // ─── Articles du blog ───────────────────────────────────────────────
    match /articles/{id} {
      allow read: if true;
      allow write: if hasPerm("articles.write");
    }

    // ─── Témoignages de membres (NOUVEAU - section "Ils témoignent") ────
    match /testimonials/{id} {
      allow read: if true;
      allow write: if hasPerm("articles.write");
    }

    // ─── Documents officiels (PDF règlement, plans d'actions...) ────────
    match /documents/{id} {
      allow read: if true;
      allow write: if hasPerm("articles.write");
    }

    // ─── Éducation & Culture — Modules (Tazawwud, etc.) ─────────────────
    match /education_modules/{id} {
      allow read: if true;  // public peut voir la structure
      allow write: if hasPerm("education.write");
    }

    // ─── Éducation & Culture — Leçons ───────────────────────────────────
    match /education_lessons/{id} {
      // Public peut lire les leçons published; admin/edu voient tout
      allow read: if resource.data.publishStatus == "published"
                  || hasPerm("education.write");
      allow create, update, delete: if hasPerm("education.write");
    }

    // ─── Notifications in-app (centre temps réel) ─────────────────────
    // Lecture : seulement les notifications destinées à l'utilisateur courant
    // Création : tout user connecté peut créer (création de demande premium
    //   par exemple — le user doit pouvoir notifier les admins). Cela
    //   reste safe car le doc créé est marqué `recipientUid` et n'a
    //   pas de "pouvoir" intrinsèque.
    // Update : seul le destinataire peut marquer comme lu
    match /notifications/{id} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn()
                          && resource.data.recipientUid == request.auth.uid;
      allow delete: if isSignedIn()
                    && (resource.data.recipientUid == request.auth.uid
                        || isAdmin());
    }

    // ─── Premium — Achats validés manuellement par admin ──────────────
    // Toute personne connectée peut créer sa propre demande de
    // déblocage premium (paiement Wave hors-bande, validation par
    // admin via /admin/premium/paiements).
    match /premium_purchases/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Le user voit ses propres commandes pour suivre l'avancement
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || hasPerm("users.write")
      );
      // Seul un admin avec users.write peut approuver / refuser
      allow update, delete: if hasPerm("users.write");
    }

    // ─── Éducation & Culture — Certifications (validation orale) ───────
    // Toute personne peut déposer une demande de certificat après avoir
    // complété le Tazawwud. Seule la Commission Éducation lit/met à jour.
    match /educationCertifications/{id} {
      allow create: if true;
      allow read, update, delete: if hasPerm("education.write");
    }

    // ─── Bibliothèque Salaatu ───────────────────────────────────────────
    match /salaatuLibrary/{id} {
      allow read: if true;
      allow write: if hasPerm("library.write");
    }

    // ─── Compteur Salaatu (auto/manuel + valeur) ────────────────────────
    match /salaatu/{id} {
      allow read: if true;
      allow write: if hasPerm("salaatu.write");
    }

    // ─── Menu navigation (custom) ───────────────────────────────────────
    // Collection réelle = "menuItems" (cf. lib/admin-data.ts).
    match /menuItems/{id} {
      allow read: if true;
      allow write: if hasPerm("menu.write");
    }

    // ─── Boutique : produits ────────────────────────────────────────────
    match /products/{id} {
      allow read: if true;
      allow write: if hasPerm("boutique.write");
    }

    // ─── Boutique : commandes ───────────────────────────────────────────
    match /orders/{id} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || hasPerm("boutique.write")
      );
      // Achat invité autorisé (le panier ne requiert pas de connexion).
      // L'intégrité (prix, statut) est contrôlée côté admin à la validation.
      allow create: if true;
      allow update, delete: if hasPerm("boutique.write");
    }

    // ─── Finances ───────────────────────────────────────────────────────
    match /finances/{id} {
      allow read, write: if hasPerm("finances.write");
    }

    // ─── Settings divers (live stream, theme, etc.) ─────────────────────
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Compteur du Challenge : lecture publique, écriture admin (règle ci-dessus),
    // PLUS un incrément public BORNÉ pour les contributions des visiteurs.
    // (Firestore applique l'union des règles : admin OU incrément validé.)
    match /settings/challenge {
      allow read: if true;
      allow update: if isAdmin() || (
        request.resource.data.total is number &&
        resource.data.total is number &&
        request.resource.data.total > resource.data.total &&
        request.resource.data.total - resource.data.total <= 5000
      );
    }

    // Journal des contributions des visiteurs : création publique bornée,
    // lecture + suppression réservées à l'admin (historique / correction).
    match /challengeContributions/{id} {
      allow read: if isAdmin() || hasPerm("members.write");
      allow create: if request.resource.data.amount is number
                    && request.resource.data.amount >= 1
                    && request.resource.data.amount <= 5000;
      allow update: if false;
      allow delete: if isAdmin() || hasPerm("members.write");
    }

    // ─── Rapports de commission (Assemblée Générale) ────────────────────
    // Chaque responsable de commission recoit un lien non reference
    // (/commissions/<slug>) et y depose le rapport de sa commission.
    // Il n'y a pas d'authentification sur ce formulaire : c'est donc ICI que
    // se fait le controle, pas dans le navigateur. La commission doit faire
    // partie de la liste officielle, les champs obligatoires doivent etre
    // remplis et chaque texte est plafonne (cf. MAX dans
    // lib/commission-reports.ts — garder les deux en phase).
    // Un rapport envoye ne peut plus etre modifie, seulement supprime par un
    // admin : c'est une piece transmise a l'assemblee.
    match /commissionReports/{id} {
      function texte(champ, maxi) {
        return champ is string && champ.size() <= maxi;
      }
      function nombreOuVide(champ) {
        return champ == null || (champ is number && champ >= 0);
      }

      allow read: if isAdmin() || estSecretariat();
      allow create: if request.resource.data.commission in [
                         "education-culture",
                         "finances",
                         "social-developpement",
                         "organisation",
                         "communication",
                         "secretariat-administratif"
                       ]
                    && request.resource.data.responsable is string
                    && request.resource.data.responsable.size() > 0
                    && request.resource.data.responsable.size() <= 120
                    && texte(request.resource.data.telephone, 120)
                    && request.resource.data.activites is string
                    && request.resource.data.activites.size() > 0
                    && request.resource.data.activites.size() <= 4000
                    && request.resource.data.propositions is string
                    && request.resource.data.propositions.size() > 0
                    && request.resource.data.propositions.size() <= 4000
                    && texte(request.resource.data.difficultes, 4000)
                    && texte(request.resource.data.salaatuPrecisions, 4000)
                    && texte(request.resource.data.cellules, 4000)
                    && texte(request.resource.data.moyens, 4000)
                    && texte(request.resource.data.divers, 4000)
                    && nombreOuVide(request.resource.data.membres)
                    && nombreOuVide(request.resource.data.salaatu)
                    && nombreOuVide(request.resource.data.cellulesActives)
                    && request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if isAdmin() || estSecretariat();
    }

    // ─── Dossiers de travail des commissions ────────────────────────────
    // Un document par commission, l'identifiant du document EST le slug.
    // Document vivant : la commission le reprend jusqu'a l'assemblee.
    //   - la commission concernee : lecture + ecriture de SON dossier
    //   - le Secretariat et l'administrateur : lecture de tous
    //   - aucune commission ne peut lire ni ecrire le dossier d'une autre
    match /commissionDossiers/{slug} {
      allow read: if isAdmin() || estSecretariat() || monSlug() == slug;
      allow write: if isAdmin() || monSlug() == slug;
    }

    // ─── Relances envoyees aux commissions ──────────────────────────────
    // Trace de la derniere relance (date + auteur). L'envoi lui-meme passe
    // par WhatsApp, hors du site. Une commission peut voir qu'elle a ete
    // relancee, mais pas relancer qui que ce soit.
    match /agRelances/{slug} {
      allow read: if isAdmin() || estSecretariat() || monSlug() == slug;
      allow write: if isAdmin() || estSecretariat();
    }

    // ─── Comptes rendus de reunion ──────────────────────────────────────
    // Rediges par le Secretariat. Tant que `publie` est faux, le compte rendu
    // est un brouillon que lui seul voit ; une fois publie, toutes les
    // commissions le lisent. Aucune commission ne peut l'ecrire.
    match /comptesRendus/{id} {
      allow read: if isAdmin() || estSecretariat()
                  || (resource.data.publie == true && monSlug() != "");
      allow write: if isAdmin() || estSecretariat();
    }

    // Médias du Challenge (annonces / Jour J avec commentaire) : affichés
    // publiquement, gérés par l'admin.
    match /challengeMedia/{id} {
      allow read: if true;
      allow write: if isAdmin() || hasPerm("gallery.write");
    }
  }
}
