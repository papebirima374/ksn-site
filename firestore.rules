rules_version = '2';

// =========================================================================
// Firestore Security Rules — Site KSN
//
// À copier-coller dans Firebase Console → Firestore Database → Rules.
// Ne pas oublier de cliquer sur "Publier" après modification.
//
// Modèle de permissions :
//   - read public : galerie photos, vidéos archives, articles, biblio
//     (tout ce qui est destiné à être affiché sur le site public)
//   - write admin : restreint aux utilisateurs avec la permission
//     correspondante dans users/<uid>.permissions[]
//
// IMPORTANT : un admin (users/<uid>.role == "admin") bypass TOUS les
// checks de permission. Ses droits ne dépendent pas de son tableau
// permissions[].
// =========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == "admin";
    }

    // Slug de la commission rattachee au compte connecte.
    // users/<uid>.commission stocke le NOM de la commission (historique du
    // projet), pas le slug : la correspondance se fait donc ici. Les anciens
    // libelles (avant la fusion Secretariat + Administratif) sont acceptes,
    // sinon les comptes deja crees perdraient l'acces a leur dossier.
    // maCommission() lit le champ SANS planter quand il est absent (un simple
    // membre n'a pas de commission) : `.get(champ, defaut)` plutot que l'acces
    // direct, qui fait echouer toute la regle sur une cle manquante.
    function maCommission() {
      return isSignedIn() ? userDoc().get("commission", "") : "";
    }

    function monSlug() {
      return !isSignedIn() ? ""
        : maCommission() == "Éducation et Culture" ? "education-culture"
        : maCommission() == "Éducation & Culture" ? "education-culture"
        : maCommission() == "Finances" ? "finances"
        : maCommission() == "Social et Développement" ? "social-developpement"
        : maCommission() == "Sociale & Développement" ? "social-developpement"
        : maCommission() == "Organisation" ? "organisation"
        : maCommission() == "Communication" ? "communication"
        : maCommission() == "Secrétariat et Administratif" ? "secretariat-administratif"
        : maCommission() == "Secrétariat" ? "secretariat-administratif"
        : maCommission() == "Administratif" ? "secretariat-administratif"
        : "";
    }

    // Le Secretariat depouille les travaux de TOUTES les commissions : c'est
    // son role a l'assemblee. Les autres commissions ne voient que le leur.
    function estSecretariat() {
      return monSlug() == "secretariat-administratif";
    }

    // hasPerm renvoie true si :
    //   - l'utilisateur est admin (bypass complet), OU
    //   - la permission est dans son tableau users/<uid>.permissions[]
    function hasPerm(perm) {
      return isSignedIn() && (
        userDoc().role == "admin"
        || (userDoc().permissions != null && perm in userDoc().permissions)
      );
    }

    // ─── Users (profils Auth + permissions) ─────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Création : par soi-même (auto-inscription) OU par un gestionnaire
      // d'utilisateurs (l'admin crée le compte via une session secondaire,
      // mais le doc Firestore est écrit sous SA session → besoin de users.write).
      allow create: if isSignedIn() && (request.auth.uid == uid || hasPerm("users.write"));
      allow update: if isSignedIn() && (request.auth.uid == uid || hasPerm("users.write"));
      allow delete: if hasPerm("users.write");
    }

    // ─── Membres du Dahira ──────────────────────────────────────────────
    // Lecture : réservée aux utilisateurs CONNECTÉS (pas le public anonyme).
    // Le lien membre↔compte se fait par email/téléphone, donc on ne peut pas
    // restreindre à "sa propre fiche" sans casser "Mon Espace" (la détection
    // du statut interroge members par email/téléphone). Le public anonyme,
    // lui, passe par /publicCards qui n'expose AUCUNE donnée privée.
    match /members/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();  // visiteur peut creer sa propre fiche
      allow update: if isSignedIn() && (
        // self-update : statut en_attente → actif (apres paiement Wave)
        (resource.data.userId == request.auth.uid
          && resource.data.statut == "en_attente"
          && request.resource.data.statut == "actif")
        || hasPerm("members.write")
      );
      // Suppression réservée aux admins (la commission peut éditer, pas supprimer).
      allow delete: if isAdmin();
    }

    // ─── Cartes publiques (vérification QR) ─────────────────────────────
    // Expose UNIQUEMENT les champs nécessaires à la vérification d'une carte
    // (nom, matricule, statut, photo, région). Aucune donnée privée.
    match /publicCards/{matricule} {
      allow read: if true;
      allow write: if hasPerm("members.write");
    }

    // ─── Dons ───────────────────────────────────────────────────────────
    // N'importe qui peut enregistrer son don ; seules les finances le lisent.
    match /donations/{id} {
      allow create: if true;
      allow read, update, delete: if hasPerm("finances.write");
    }

    // ─── Galerie photos ─────────────────────────────────────────────────
    match /gallery/{id} {
      allow read: if true;  // tout le monde voit les photos
      allow write: if hasPerm("gallery.write");
    }

    // ─── Vidéos YouTube archivées ───────────────────────────────────────
    match /youtube_links/{id} {
      allow read: if true;
      allow write: if hasPerm("gallery.write");
    }

    // ─── Newsletter ─────────────────────────────────────────────────────
    match /newsletter/{id} {
      // N'importe qui peut s'inscrire, sans compte : c'est le principe d'une
      // lettre d'information. Mais « allow create: if true » laissait ecrire
      // n'importe quoi dans la collection — un champ de 200 Ko, mille cles
      // inventees. On borne donc la FORME du document : trois champs connus,
      // une adresse qui ressemble a une adresse, une taille raisonnable.
      // Cela n'empeche pas une fausse inscription ; cela empeche que la
      // collection serve a autre chose qu'a des inscriptions.
      allow create: if request.resource.data.keys().hasOnly(
                         ["email", "source", "subscribedAt"])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 4
                    && request.resource.data.email.size() < 200
                    && request.resource.data.email.matches(".+@.+[.].+")
                    && request.resource.data.source is string
                    && request.resource.data.source.size() < 60
                    && request.resource.data.subscribedAt is int;

      // Lecture et desinscription : la Communication, qui redige la lettre,
      // et le Secretariat, qui tient le fichier des membres.
      allow read, delete: if hasPerm("articles.write") || hasPerm("members.write");
      // Personne ne modifie une inscription : on s'inscrit ou on se
      // desinscrit. Une adresse modifiable serait une adresse usurpable.
      allow update: if false;
    }

    // ─── Articles du blog ───────────────────────────────────────────────
    match /articles/{id} {
      allow read: if true;
      allow write: if hasPerm("articles.write");
    }

    // ─── Témoignages de membres (NOUVEAU - section "Ils témoignent") ────
    match /testimonials/{id} {
      allow read: if true;
      allow write: if hasPerm("articles.write");
    }

    // ─── Documents officiels (PDF règlement, plans d'actions...) ────────
    match /documents/{id} {
      allow read: if true;
      allow write: if hasPerm("articles.write");
    }

    // ─── Notifications in-app (centre temps réel) ─────────────────────
    // Lecture : seulement les notifications destinées à l'utilisateur courant
    // Création : tout user connecté peut créer (création de demande premium
    //   par exemple — le user doit pouvoir notifier les admins). Cela
    //   reste safe car le doc créé est marqué `recipientUid` et n'a
    //   pas de "pouvoir" intrinsèque.
    // Update : seul le destinataire peut marquer comme lu
    // Une notification peut aussi viser une COMMISSION (champ
    // recipientCommission = slug) plutot qu'une personne : un responsable ne
    // peut pas lire users/*, donc il ne connait pas l'uid de son homologue.
    // Adresser la commission resout le probleme et survit au changement de
    // responsable. L'ordre des conditions compte : le cas nominatif, le plus
    // frequent, court-circuite avant d'aller lire le profil.
    match /notifications/{id} {
      function pourMoi() {
        return resource.data.recipientUid == request.auth.uid
               || (resource.data.get("recipientCommission", "") != ""
                   && resource.data.get("recipientCommission", "") == monSlug());
      }
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && pourMoi();
      allow delete: if isSignedIn() && (pourMoi() || isAdmin());
    }

    // ─── Premium — Achats validés manuellement par admin ──────────────
    // Toute personne connectée peut créer sa propre demande de
    // déblocage premium (paiement Wave hors-bande, validation par
    // admin via /admin/premium/paiements).
    match /premium_purchases/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Le user voit ses propres commandes pour suivre l'avancement
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || hasPerm("users.write")
      );
      // Seul un admin avec users.write peut approuver / refuser
      allow update, delete: if hasPerm("users.write");
    }

    // ─── Bibliothèque Salaatu ───────────────────────────────────────────
    match /salaatuLibrary/{id} {
      allow read: if true;
      allow write: if hasPerm("library.write");
    }

    // ─── Compteur Salaatu (auto/manuel + valeur) ────────────────────────
    match /salaatu/{id} {
      allow read: if true;
      allow write: if hasPerm("salaatu.write");
    }

    // ─── Menu navigation (custom) ───────────────────────────────────────
    // Collection réelle = "menuItems" (cf. lib/admin-data.ts).
    match /menuItems/{id} {
      allow read: if true;
      allow write: if hasPerm("menu.write");
    }

    // ─── Boutique : produits ────────────────────────────────────────────
    match /products/{id} {
      allow read: if true;
      allow write: if hasPerm("boutique.write");
    }

    // ─── Boutique : commandes ───────────────────────────────────────────
    match /orders/{id} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || hasPerm("boutique.write")
      );
      // Achat invité autorisé (le panier ne requiert pas de connexion).
      // L'intégrité (prix, statut) est contrôlée côté admin à la validation.
      allow create: if true;
      allow update, delete: if hasPerm("boutique.write");
    }

    // ─── Finances ───────────────────────────────────────────────────────
    match /finances/{id} {
      allow read, write: if hasPerm("finances.write");
    }

    // ─── Configuration de la Journee (lien du direct YouTube) ───────────
    // Cette collection n'avait AUCUNE regle : Firestore refuse par defaut ce
    // qui n'est pas explicitement autorise. Le lien du direct ne pouvait donc
    // pas etre enregistre — et l'echec ne se voyait nulle part, l'erreur
    // partant dans la console du navigateur.
    //
    // Lecture publique : le lien s'affiche sur la page de la Journee, pour des
    // visiteurs qui ne sont pas connectes.
    match /config/{id} {
      allow read: if true;
      allow write: if hasPerm("salaatu.write");
    }

    // ─── Settings divers (live stream, theme, etc.) ─────────────────────
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Compteur du Challenge : lecture publique, écriture admin (règle ci-dessus),
    // PLUS un incrément public BORNÉ pour les contributions des visiteurs.
    // (Firestore applique l'union des règles : admin OU incrément validé.)
    match /settings/challenge {
      allow read: if true;
      allow update: if isAdmin() || (
        request.resource.data.total is number &&
        resource.data.total is number &&
        request.resource.data.total > resource.data.total &&
        request.resource.data.total - resource.data.total <= 5000
      );
    }

    // Journal des contributions des visiteurs : création publique bornée,
    // lecture + suppression réservées à l'admin (historique / correction).
    match /challengeContributions/{id} {
      allow read: if isAdmin() || hasPerm("members.write");
      allow create: if request.resource.data.amount is number
                    && request.resource.data.amount >= 1
                    && request.resource.data.amount <= 5000;
      allow update: if false;
      allow delete: if isAdmin() || hasPerm("members.write");
    }

    // ─── Rapports de commission (Assemblée Générale) ────────────────────
    // Chaque responsable de commission recoit un lien non reference
    // (/commissions/<slug>) et y depose le rapport de sa commission.
    // Il n'y a pas d'authentification sur ce formulaire : c'est donc ICI que
    // se fait le controle, pas dans le navigateur. La commission doit faire
    // partie de la liste officielle, les champs obligatoires doivent etre
    // remplis et chaque texte est plafonne (cf. MAX dans
    // lib/commission-reports.ts — garder les deux en phase).
    // Un rapport envoye ne peut plus etre modifie, seulement supprime par un
    // admin : c'est une piece transmise a l'assemblee.
    match /commissionReports/{id} {
      function texte(champ, maxi) {
        return champ is string && champ.size() <= maxi;
      }
      function nombreOuVide(champ) {
        return champ == null || (champ is number && champ >= 0);
      }

      allow read: if isAdmin() || estSecretariat();
      allow create: if request.resource.data.commission in [
                         "education-culture",
                         "finances",
                         "social-developpement",
                         "organisation",
                         "communication",
                         "secretariat-administratif"
                       ]
                    && request.resource.data.responsable is string
                    && request.resource.data.responsable.size() > 0
                    && request.resource.data.responsable.size() <= 120
                    && texte(request.resource.data.telephone, 120)
                    && request.resource.data.activites is string
                    && request.resource.data.activites.size() > 0
                    && request.resource.data.activites.size() <= 4000
                    && request.resource.data.propositions is string
                    && request.resource.data.propositions.size() > 0
                    && request.resource.data.propositions.size() <= 4000
                    && texte(request.resource.data.difficultes, 4000)
                    && texte(request.resource.data.salaatuPrecisions, 4000)
                    && texte(request.resource.data.cellules, 4000)
                    && texte(request.resource.data.moyens, 4000)
                    && texte(request.resource.data.divers, 4000)
                    && nombreOuVide(request.resource.data.membres)
                    && nombreOuVide(request.resource.data.salaatu)
                    && nombreOuVide(request.resource.data.cellulesActives)
                    && request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if isAdmin() || estSecretariat();
    }

    // ─── Dossiers de travail des commissions ────────────────────────────
    // Un document par commission, l'identifiant du document EST le slug.
    // Document vivant : la commission le reprend jusqu'a l'assemblee.
    //   - la commission concernee : lecture + ecriture de SON dossier
    //   - le Secretariat et l'administrateur : lecture de tous
    //   - aucune commission ne peut lire ni ecrire le dossier d'une autre
    match /commissionDossiers/{slug} {
      allow read: if isAdmin() || estSecretariat() || monSlug() == slug;
      allow write: if isAdmin() || monSlug() == slug;

      // Le Secretariat fait suivre le dossier au President, ou le renvoie a la
      // commission pour complement. Il agit donc sur le CIRCUIT — et sur lui
      // seul : la liste des champs autorises l'empeche de recrire une ligne de
      // ce que la commission a redige.
      allow update: if estSecretariat()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["statut", "transmisAt", "transmisPar",
                                   "valideAt", "validePar", "updatedAt"]);
    }

    // ─── Relances envoyees aux commissions ──────────────────────────────
    // Trace de la derniere relance (date + auteur). L'envoi lui-meme passe
    // par WhatsApp, hors du site. Une commission peut voir qu'elle a ete
    // relancee, mais pas relancer qui que ce soit.
    // ─── Caisse propre d'une commission ─────────────────────────────────
    // AUCUN rapport avec les finances nationales (collection `finances`) :
    // deux registres distincts, jamais additionnes. Une commission ne voit et
    // n'alimente que la sienne.
    //
    // Une ecriture ne se MODIFIE jamais et ne s'EFFACE pas : on l'annule par
    // une ecriture inverse. Une caisse dont on peut reecrire les lignes ne
    // vaut rien devant les membres. Seul l'administrateur peut supprimer, en
    // dernier recours (donnees de test, doublon flagrant).
    //
    // Ecrivent : tous les comptes rattaches a la commission. Pour donner la
    // main au tresorier, l'administrateur lui cree un compte rattache a la
    // meme commission — le champ createdBy garde qui a saisi quoi.
    //
    // SAUF LA FINANCE. Elle tient deja la caisse NATIONALE (collection
    // `finances`) : le Dahira n'a qu'un compte, le compte principal. Lui
    // ouvrir une caisse de commission a cote reviendrait a tenir deux
    // registres, et plus personne ne saurait lequel fait foi. La regle le
    // refuse donc, et pas seulement l'interface.
    match /commissionCaisse/{id} {
      allow read: if isAdmin() || estSecretariat()
                  || resource.data.commission == monSlug();
      allow create: if (isAdmin() || request.resource.data.commission == monSlug())
                    && request.resource.data.commission != "finances"
                    && request.resource.data.sens in ["entree", "sortie"]
                    && request.resource.data.montant is number
                    && request.resource.data.montant > 0
                    && request.resource.data.montant <= 100000000
                    && request.resource.data.motif is string
                    && request.resource.data.motif.size() <= 160
                    && request.resource.data.date is string
                    && request.resource.data.date.size() == 10
                    && request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ─── Activites economiques d'une commission ─────────────────────────
    // Les lots : une fournee de cafe, un lot revendu lors d'un evenement.
    // Les quantites et les montants sont bornes ; la marge n'est pas stockee,
    // elle se deduit, pour qu'elle ne puisse jamais contredire la saisie.
    match /commissionActivites/{id} {
      allow read: if isAdmin() || estSecretariat()
                  || resource.data.commission == monSlug();
      allow create, update: if (isAdmin() || request.resource.data.commission == monSlug())
                    && request.resource.data.type in ["production", "evenement"]
                    && request.resource.data.quantite is number
                    && request.resource.data.quantite >= 0
                    && request.resource.data.coutTotal is number
                    && request.resource.data.coutTotal >= 0
                    && request.resource.data.prixUnitaire is number
                    && request.resource.data.prixUnitaire >= 0
                    && request.resource.data.quantiteVendue is number
                    && request.resource.data.quantiteVendue >= 0
                    && request.resource.data.libelle is string
                    && request.resource.data.libelle.size() <= 160;
      allow delete: if isAdmin() || resource.data.commission == monSlug();
    }

    // ─── Aides versees aux membres ──────────────────────────────────────
    // Une aide sort de la caisse de la commission, jamais de la caisse
    // nationale. Les deux ecritures partent ensemble : l'aide n'a de sens
    // que si la caisse bouge avec elle.
    //
    // Une aide ne se reecrit pas et ne s'efface pas : on corrige en annulant
    // l'ecriture de caisse correspondante, qui reste tracee.
    match /commissionAides/{id} {
      allow read: if isAdmin() || estSecretariat()
                  || resource.data.commission == monSlug();
      allow create: if (isAdmin() || request.resource.data.commission == monSlug())
                    && request.resource.data.montant is number
                    && request.resource.data.montant > 0
                    && request.resource.data.montant <= 100000000
                    && request.resource.data.membreNom is string
                    && request.resource.data.membreNom.size() > 0
                    && request.resource.data.motif is string
                    && request.resource.data.motif.size() <= 80
                    && request.resource.data.date is string
                    && request.resource.data.date.size() == 10;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ─── Ventes au comptoir de la boutique ──────────────────────────────
    // La commission Sociale tient la boutique : chaque vente s'inscrit ici et
    // entre dans SA caisse, en une seule operation (cf. lib/commission-ventes).
    // Le total est fige a l'enregistrement — une facture deja remise au client
    // ne se recalcule pas.
    //
    // Une vente ne se reecrit pas. Pour corriger, on l'annule : elle reste au
    // registre, barree, et la caisse est compensee par une sortie. Le seul
    // `update` autorise est donc celui de l'annulation, borne a ses champs.
    match /commissionVentes/{id} {
      allow read: if isAdmin() || estSecretariat()
                  || resource.data.commission == monSlug();

      allow create: if (isAdmin() || request.resource.data.commission == monSlug())
                    && request.resource.data.numero is string
                    && request.resource.data.numero.size() > 0
                    && request.resource.data.numero.size() <= 40
                    && request.resource.data.total is number
                    && request.resource.data.total > 0
                    && request.resource.data.total <= 100000000
                    && request.resource.data.lignes is list
                    && request.resource.data.lignes.size() > 0
                    && request.resource.data.lignes.size() <= 50
                    && request.resource.data.date is string
                    && request.resource.data.date.size() == 10
                    && request.resource.data.createdAt is number
                    && request.resource.data.annulee == false;

      // Annulation, et rien d'autre : ni le total, ni les lignes, ni le numero.
      allow update: if (isAdmin() || resource.data.commission == monSlug())
                    && resource.data.annulee == false
                    && request.resource.data.annulee == true
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["annulee", "annuleePar", "annuleeAt", "motifAnnulation"])
                    && request.resource.data.motifAnnulation is string
                    && request.resource.data.motifAnnulation.size() <= 300
                    && request.resource.data.annuleeAt is number;

      allow delete: if isAdmin();
    }

    // ─── Versements entre caisses de commission ─────────────────────────
    // La Finance verse a une commission depuis la caisse NATIONALE ; la
    // commission destinataire accuse reception. Deux ecritures encadrent le
    // versement :
    //   - au depart : une DEPENSE au compte principal (collection `finances`),
    //     ecrite par le tresorier, qui a la permission finances.write
    //   - a l'accuse : une ENTREE dans la caisse de la commission destinataire,
    //     ecrite par elle seule
    // Chacune par celui que cela regarde, jamais par l'autre.
    //
    // Qui peut quoi :
    //   - creer   : la commission emettrice uniquement, et elle seule figure
    //               au champ `de` (sans quoi n'importe qui pourrait inventer
    //               un versement au nom de la Finances)
    //   - accuser : la commission destinataire uniquement, et seulement sur
    //               un versement encore en attente
    //   - annuler : la commission emettrice, et seulement tant que la
    //               reception n'est pas accusee
    //   - lire    : les deux commissions concernees, le Secretariat, l'admin
    //
    // Rien ne se reecrit : les deux `update` autorises sont bornes aux champs
    // de l'accuse ou de l'annulation, et le montant ne bouge jamais.
    match /commissionTransferts/{id} {
      function estDestinataire() {
        return monSlug() == resource.data.vers;
      }
      function estEmettrice() {
        return monSlug() == resource.data.de;
      }
      function change(champs) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(champs);
      }

      allow read: if isAdmin() || estSecretariat()
                  || monSlug() == resource.data.de
                  || monSlug() == resource.data.vers;

      allow create: if (isAdmin() || request.resource.data.de == monSlug())
                    && request.resource.data.de == "finances"
                    && request.resource.data.vers in [
                         "education-culture",
                         "social-developpement",
                         "organisation",
                         "communication",
                         "secretariat-administratif"
                       ]
                    && request.resource.data.vers != request.resource.data.de
                    && request.resource.data.montant is number
                    && request.resource.data.montant > 0
                    && request.resource.data.montant <= 100000000
                    && request.resource.data.statut == "envoye"
                    && request.resource.data.motif is string
                    && request.resource.data.motif.size() <= 300
                    && request.resource.data.moyen is string
                    && request.resource.data.moyen.size() <= 40
                    && request.resource.data.reference is string
                    && request.resource.data.reference.size() <= 80
                    && request.resource.data.date is string
                    && request.resource.data.date.size() == 10
                    && request.resource.data.envoyeAt is number
                    && request.resource.data.recuPar == ""
                    && request.resource.data.recuAt == 0;

      // Accuse de reception : le destinataire, sur un versement en attente.
      allow update: if (isAdmin() || estDestinataire())
                    && resource.data.statut == "envoye"
                    && request.resource.data.statut == "recu"
                    && change(["statut", "recuPar", "recuAt", "observation",
                               "ecritureDestinataire"])
                    && request.resource.data.observation is string
                    && request.resource.data.observation.size() <= 300
                    && request.resource.data.recuAt is number;

      // Annulation : l'emettrice, tant que la reception n'est pas accusee.
      allow update: if (isAdmin() || estEmettrice())
                    && resource.data.statut == "envoye"
                    && request.resource.data.statut == "annule"
                    && change(["statut", "annulePar", "annuleAt", "motifAnnulation"])
                    && request.resource.data.motifAnnulation is string
                    && request.resource.data.motifAnnulation.size() <= 300
                    && request.resource.data.annuleAt is number;

      allow delete: if isAdmin();
    }

    // ─── Membres d'une commission ───────────────────────────────────────
    // Une simple liste, piochee dans les membres du Dahira. Ces personnes
    // n'ont PAS de compte : rien ici ne donne d'acces au site.
    match /commissionMembres/{id} {
      allow read: if isAdmin() || estSecretariat()
                  || resource.data.commission == monSlug();
      allow create, update: if isAdmin()
                            || request.resource.data.commission == monSlug();
      allow delete: if isAdmin() || resource.data.commission == monSlug();
    }

    // ─── Feuille de route d'une journee ─────────────────────────────────
    // Qui fait quoi, pour quand, avec quel budget. Le budget porte ici est
    // PREVISIONNEL : il ne touche pas la caisse, qui reste la seule a dire ce
    // qui est reellement sorti. Une tache se reprend autant de fois qu'il faut
    // — un plan qu'on ne peut pas corriger ne sert a rien — mais elle ne peut
    // pas changer de commission en route.
    match /commissionTaches/{id} {
      allow read: if isAdmin() || estSecretariat()
                  || resource.data.commission == monSlug();
      allow create, update: if (isAdmin() || request.resource.data.commission == monSlug())
                    && request.resource.data.libelle is string
                    && request.resource.data.libelle.size() > 0
                    && request.resource.data.libelle.size() <= 160
                    && request.resource.data.statut in ["a_faire", "en_cours", "fait", "bloque"]
                    && request.resource.data.budget is number
                    && request.resource.data.budget >= 0
                    && request.resource.data.budget <= 100000000
                    && request.resource.data.depense is number
                    && request.resource.data.depense >= 0
                    && request.resource.data.depense <= 100000000;
      allow delete: if isAdmin() || resource.data.commission == monSlug();
    }

    // ─── Reunions et convocations ───────────────────────────────────────
    // Toutes les commissions, pas seulement l'Organisation.
    match /commissionReunions/{id} {
      allow read: if isAdmin() || estSecretariat()
                  || resource.data.commission == monSlug();
      allow create, update: if isAdmin()
                            || request.resource.data.commission == monSlug();
      allow delete: if isAdmin() || resource.data.commission == monSlug();
    }

    // ─── Fil de discussion des commissions ──────────────────────────────
    // La continuite apres l'assemblee : chaque commission echange ici avec le
    // Secretariat et la Presidence. Un message porte le slug de sa commission.
    //   - lecture : la commission concernee, le Secretariat, l'administrateur
    //   - ecriture : les memes — une commission ne peut pas poster dans le fil
    //     d'une autre, la regle verifie le champ commission a la creation
    //   - modification : impossible, un message ne se reecrit pas
    //   - suppression : administrateur seul
    match /commissionMessages/{id} {
      allow read: if isAdmin() || estSecretariat() || resource.data.commission == monSlug();
      allow create: if (isAdmin() || estSecretariat()
                        || request.resource.data.commission == monSlug())
                    && request.resource.data.commission is string
                    && request.resource.data.texte is string
                    && request.resource.data.texte.size() > 0
                    && request.resource.data.texte.size() <= 2000
                    && request.resource.data.auteur is string
                    && request.resource.data.auteur.size() <= 120
                    && request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /agRelances/{slug} {
      allow read: if isAdmin() || estSecretariat() || monSlug() == slug;
      allow write: if isAdmin() || estSecretariat();
    }

    // ─── Comptes rendus de reunion ──────────────────────────────────────
    // Rediges par le Secretariat. Tant que `publie` est faux, le compte rendu
    // est un brouillon que lui seul voit ; une fois publie, toutes les
    // commissions le lisent. Aucune commission ne peut l'ecrire.
    match /comptesRendus/{id} {
      allow read: if isAdmin() || estSecretariat()
                  || (resource.data.publie == true && monSlug() != "");
      allow write: if isAdmin() || estSecretariat();
    }

    // Médias du Challenge (annonces / Jour J avec commentaire) : affichés
    // publiquement, gérés par l'admin.
    match /challengeMedia/{id} {
      allow read: if true;
      allow write: if isAdmin() || hasPerm("gallery.write");
    }
  }
}
