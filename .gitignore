# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal documents (sensitive, not for public repo)
/documents

# Données personnelles des membres — JAMAIS dans le dépôt public.
# Cartes de membre (PDF Canva), texte extrait et JSON d'import contiennent
# noms + téléphones. Restent en local pour la commission administrative.
/docs/*.pdf
/docs/pdf*.txt
/docs/membres-import.json

.vercel

# cache polices du generateur de visuels
/scripts/.fonts-cache
