# ---------------------------------------------------------------------------
# Variables d'environnement du site KSN — MODELE (aucun secret ici).
#
# Copier ce fichier en `.env.local` puis remplir les valeurs :
#     cp .env.example .env.local
#
# Le plus simple : `npx vercel link` puis `npx vercel env pull .env.local`
# (recupere directement les valeurs deja configurees sur Vercel).
# ---------------------------------------------------------------------------

# --- Firebase (client) ------------------------------------------------------
# Console Firebase > Parametres du projet > Vos applications > Configuration SDK.
# Ces valeurs sont publiques (prefixe NEXT_PUBLIC_) : la securite repose sur
# firestore.rules et storage.rules, pas sur le secret de ces cles.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Resend (envoi d'e-mails, app/api/send-email) ---------------------------
# Tableau de bord Resend > API Keys. Une cle perdue ne se relit pas :
# en creer une nouvelle et supprimer l'ancienne.
RESEND_API_KEY=

# --- Google Cloud Text-to-Speech (lib/tts) ----------------------------------
# Optionnel : sans cette cle, la synthese vocale bascule sur msedge-tts.
# Google Cloud Console > API et services > Identifiants > Cle API.
GOOGLE_TTS_API_KEY=
