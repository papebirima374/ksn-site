rules_version = '2';

// =========================================================================
// Firebase Storage Rules — Site KSN
//
// À copier-coller dans Firebase Console → Storage → Rules, puis "Publier".
//
// - Lecture PUBLIQUE : les photos (membres, galerie, produits) sont affichées
//   sur le site public.
// - Écriture : réservée aux utilisateurs CONNECTÉS, limitée aux images de
//   moins de 8 Mo. (L'accès aux écrans d'upload est déjà restreint par les
//   permissions admin côté application.)
// =========================================================================
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
